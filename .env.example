# Required: fill in all four passwords before running Docker Compose.
MONGO_INITDB_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Optional: defaults shown below.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_APP_USERNAME=appuser
MONGO_APP_DATABASE=prescriptions
MYSQL_DATABASE=cms
MYSQL_USER=clinicdb

# Required: long random signing key (32+ random bytes). Never commit the real value.
JWT_SECRET=
